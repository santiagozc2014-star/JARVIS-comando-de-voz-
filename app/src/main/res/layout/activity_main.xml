<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/jarvis_logo_description"
            android:src="@drawable/ic_jarvis" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/jarvis_cyan"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Estado: DETENIDO"
            android:textColor="@color/jarvis_text"
            android:textSize="17sp" />
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Iniciar escucha continua" />
        <Button
            android:id="@+id/btnOpenJarvisChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Abrir conversación JARVIS" />
        <Button
            android:id="@+id/btnOpenMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gestionar memoria de JARVIS" />
        <Button
            android:id="@+id/btnTestChatGpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Probar apertura de ChatGPT" />
        <Button
            android:id="@+id/btnSamsungBatterySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Configurar batería Samsung" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Añade JARVIS a «Aplicaciones que nunca se suspenden» para reducir cierres en segundo plano."
            android:textColor="@color/jarvis_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/thresholdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/jarvis_text"
            android:text="Sensibilidad: 0.50" />
        <SeekBar
            android:id="@+id/thresholdSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="42" />
        <TextView
            android:id="@+id/lastScoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/jarvis_muted"
            android:text="Sin detecciones todavía" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/privacy_notice"
            android:textColor="@color/jarvis_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
