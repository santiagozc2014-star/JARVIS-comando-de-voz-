<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/jarvis_background" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="12dp">
<ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="@string/jarvis_logo_description" android:src="@drawable/ic_jarvis"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="MEMORIA DE J.A.R.V.I.S." android:textColor="@color/jarvis_cyan" android:textSize="18sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/jarvis_panel" android:padding="14dp" android:text="Recuerdos locales cifrados. JARVIS no guarda nada automáticamente." android:textColor="@color/jarvis_muted" android:textSize="13sp"/>
<EditText android:id="@+id/memorySearch" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/jarvis_input" android:hint="Buscar recuerdos…" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="@color/jarvis_text" android:textColorHint="@color/jarvis_muted"/>
<Button android:id="@+id/memoryAddButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Añadir recuerdo" android:textAllCaps="false"/>
<TextView android:id="@+id/memoryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Todavía no hay recuerdos guardados." android:textColor="@color/jarvis_muted" android:textSize="14sp"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:id="@+id/memoryEntries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</ScrollView></LinearLayout>