<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/jarvis_background" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="10dp">
<ImageView android:layout_width="38dp" android:layout_height="38dp" android:contentDescription="@string/jarvis_logo_description" android:src="@drawable/ic_jarvis"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="J.A.R.V.I.S." android:textColor="@color/jarvis_cyan" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:id="@+id/chatProviderStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/jarvis_input" android:padding="8dp" android:text="Proveedor: no conectado" android:textColor="@color/jarvis_muted" android:textSize="11sp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/jarvis_panel" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
<CheckBox android:id="@+id/chatSaveHistory" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/jarvis_cyan" android:minHeight="48dp" android:text="Guardar historial cifrado en este dispositivo" android:textColor="@color/jarvis_text" android:textSize="12sp"/>
<Button android:id="@+id/chatClearHistory" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Borrar" android:textAllCaps="false" android:textSize="12sp"/>
</LinearLayout>
<ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:id="@+id/chatTranscript" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/jarvis_panel" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
<EditText android:id="@+id/chatInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Escribe a JARVIS…" android:imeOptions="actionSend" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:minHeight="48dp" android:padding="8dp" android:textColor="@color/jarvis_text" android:textColorHint="@color/jarvis_muted"/>
<Button android:id="@+id/chatSendButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Enviar" android:textAllCaps="false"/>
</LinearLayout></LinearLayout>